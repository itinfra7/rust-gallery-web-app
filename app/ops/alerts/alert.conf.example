ALERT_APP_ROOT="<APP_ROOT>"
ALERT_APP_USER="<APP_USER>"
ALERT_APP_GROUP="<APP_GROUP>"
ALERT_OPS_STATUS_DIR="${ALERT_APP_ROOT}/run/ops-status"
ALERT_SPOOL_FILE="${ALERT_APP_ROOT}/run/alerts.ndjson"
ALERT_DEDUPE_DIR="${ALERT_OPS_STATUS_DIR}/alert-dedupe"
ALERT_STREAK_DIR="${ALERT_OPS_STATUS_DIR}/alert-streaks"
ALERT_NOTIFY_INFO="yes"
ALERT_DEDUPE_COOLDOWN_SECONDS="900"
ALERT_FAILURE_STREAK_THRESHOLD="1"
ALERT_TELEGRAM_TIMEOUT_SECONDS="15"

# Optional per-kind overrides.
# Use the alert kind name in upper snake case, for example:
# ALERT_KIND_NOTIFY_MANUAL_TEST="no"
# ALERT_KIND_NOTIFY_BACKUP_SUCCESS="yes"
ALERT_KIND_NOTIFY_BACKUP_SUCCESS="no"
ALERT_KIND_NOTIFY_MAINTENANCE_SUCCESS="no"
ALERT_KIND_NOTIFY_REBUILD_SUCCESS="no"
ALERT_KIND_NOTIFY_RESTORE_REHEARSAL_SUCCESS="no"
ALERT_KIND_NOTIFY_ROLLBACK_SUCCESS="no"
ALERT_KIND_NOTIFY_SMOKE_CHECK_SUCCESS="no"

# Optional per-kind failure streak thresholds.
# For example:
# ALERT_KIND_FAILURE_STREAK_THRESHOLD_BACKUP_FAILED="2"
ALERT_KIND_FAILURE_STREAK_THRESHOLD_BACKUP_FAILED="2"
ALERT_KIND_FAILURE_STREAK_THRESHOLD_MAINTENANCE_FAILED="2"
ALERT_KIND_FAILURE_STREAK_THRESHOLD_RESTORE_REHEARSAL_FAILED="2"
ALERT_KIND_FAILURE_STREAK_THRESHOLD_REBUILD_FAILED="1"
ALERT_KIND_FAILURE_STREAK_THRESHOLD_DISK_LOW="1"
ALERT_KIND_FAILURE_STREAK_THRESHOLD_SMOKE_CHECK_FAILED="1"
ALERT_KIND_FAILURE_STREAK_THRESHOLD_ROLLBACK_FAILED="1"

# Fill these later after creating a Telegram bot and identifying the target chat.
ALERT_TELEGRAM_BOT_TOKEN="<TELEGRAM_BOT_TOKEN>"
ALERT_TELEGRAM_CHAT_ID="<TELEGRAM_CHAT_ID>"
